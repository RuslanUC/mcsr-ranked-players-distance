<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Calculate distance (in matches) between {{ app_type }} players">
    <meta name="keywords" content="mcsr ranked,draftout,players distance,match distance,minecraft,minecraft speedrunning">
    <title>{{ app_type }} players distance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <style>
        html, body {
            width: 100% !important;
            height: 100% !important;
        }
    </style>
</head>
<body>
<main class="container-fluid min-vh-100 d-flex flex-column justify-content-center align-items-center">
    <form action="" id="get-distance-form" class="w-100" style="max-width: 640px">
        <p class="fs-2">Get {{ app_type }} distance between</p>
        <input type="text" class="form-control my-2" name="player1" id="player1" required placeholder="a player" aria-label="first player"/>
        <p class="w-100 text-center fs-3 m-0">AND</p>
        <input type="text" class="form-control my-2" name="player2" id="player2" required placeholder="another player" aria-label="second player"/>

        <button type="submit" class="btn btn-primary w-100 mb-3" form="get-distance-form" id="get-distance-btn">Get</button>

        <div class="alert alert-danger d-none align-items-center gap-3" role="alert" id="alert-error"></div>
        <div class="alert alert-secondary d-none align-items-center gap-3" role="alert" id="alert-info"></div>
    </form>
</main>

<footer>
    <ul class="nav justify-content-center border-bottom border-top py-1 my-1">
        <li class="nav-item"><a href="/" class="nav-link px-2 text-body-secondary">Home</a></li>
        <li class="nav-item"><a href="/draftout" class="nav-link px-2 text-body-secondary">Draftout mode</a></li>
        <li class="nav-item"><a href="/faq" class="nav-link px-2 text-body-secondary">FAQs</a></li>
    </ul>
    <p class="text-center text-body-secondary py-2">
        This is <a href="https://mcsrranked.com/">MCSR Ranked</a>/<a href="https://draftoutmc.com/">Draftout</a> fan project.
        Not affiliated or associated with MCSR Ranked, Draftout, Mojang or Microsoft.
    </p>
</footer>

<script>
    const IS_DRAFTOUT = {% if is_draftout %}true{% else %}false{% endif %};
</script>
<script src="main.js"></script>
</body>
</html>